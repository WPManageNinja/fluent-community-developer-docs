{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/analytics/spaces/widget": {
      "get": {
        "operationId": "getSpaceWidgetReport",
        "summary": "GET Get Space Widget Report",
        "description": "Returns the space counters for a date range — spaces, posts, comments and members — optionally narrowed to one space.\n\nController: `SpacesReportsController@widget`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:85`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "space_id",
            "in": "query",
            "required": false,
            "description": "Space ID read via `$request->getSafe()` in widget().",
            "schema": {
              "type": "string",
              "default": "null"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "total_comments": {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "string",
                              "nullable": false
                            },
                            "title": {
                              "type": "string",
                              "nullable": false
                            },
                            "total_records": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "total_members": {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "string",
                              "nullable": false
                            },
                            "title": {
                              "type": "string",
                              "nullable": false
                            },
                            "total_records": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "total_posts": {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "string",
                              "nullable": false
                            },
                            "title": {
                              "type": "string",
                              "nullable": false
                            },
                            "total_records": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "total_spaces": {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "string",
                              "nullable": false
                            },
                            "title": {
                              "type": "string",
                              "nullable": false
                            },
                            "total_records": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "data": {
                    "total_comments": {
                      "comparison": "+100",
                      "title": "New tutorial: getting started with the API",
                      "total_records": 3
                    },
                    "total_members": {
                      "comparison": "+100",
                      "title": "New tutorial: getting started with the API",
                      "total_records": 3
                    },
                    "total_posts": {
                      "comparison": "+100",
                      "title": "Community guidelines refresh",
                      "total_records": 3
                    },
                    "total_spaces": {
                      "comparison": "+100",
                      "title": "New tutorial: getting started with the API",
                      "total_records": 3
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

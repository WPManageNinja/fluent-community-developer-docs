{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/analytics/overview/popular-day-time": {
      "get": {
        "operationId": "getPopularDayTimeReport",
        "summary": "GET Get Popular Day Time Report",
        "description": "Returns a day-of-week by time-of-day heatmap of community activity, as a fixed grid of six four-hour blocks against the seven weekdays.\n\nController: `ReportsController@popularDayTimeReport`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:73`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "nullable": false
                              },
                              "prop": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "Friday": {
                                "type": "integer"
                              },
                              "Monday": {
                                "type": "integer"
                              },
                              "Saturday": {
                                "type": "integer"
                              },
                              "Sunday": {
                                "type": "integer"
                              },
                              "Thursday": {
                                "type": "integer"
                              },
                              "Tuesday": {
                                "type": "integer"
                              },
                              "Wednesday": {
                                "type": "integer"
                              },
                              "time_range": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "data": {
                    "columns": [
                      {
                        "label": "Time Range",
                        "prop": "time_range"
                      },
                      {
                        "label": "Mon",
                        "prop": "Monday"
                      },
                      {
                        "label": "Tue",
                        "prop": "Tuesday"
                      }
                    ],
                    "data": [
                      {
                        "Friday": 47,
                        "Monday": 32,
                        "Saturday": 43,
                        "Sunday": 52,
                        "Thursday": 85,
                        "Tuesday": 63,
                        "Wednesday": 56,
                        "time_range": "12:00 AM-3:59 AM"
                      },
                      {
                        "Friday": 25,
                        "Monday": 28,
                        "Saturday": 39,
                        "Sunday": 7,
                        "Thursday": 49,
                        "Tuesday": 28,
                        "Wednesday": 28,
                        "time_range": "4:00 AM-7:59 AM"
                      },
                      {
                        "Friday": 37,
                        "Monday": 21,
                        "Saturday": 31,
                        "Sunday": 8,
                        "Thursday": 35,
                        "Tuesday": 21,
                        "Wednesday": 29,
                        "time_range": "8:00 AM-11:59 AM"
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

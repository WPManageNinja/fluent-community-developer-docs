    "/analytics/spaces/popular": {
      "get": {
        "operationId": "listPopularSpacesReport",
        "summary": "GET List Popular Spaces Report",
        "description": "Returns a ranked table of the busiest spaces, or — when `space_id` is supplied — the busiest posts inside that one space.\n\nController: `SpacesReportsController@getTopSpaces`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:90`",

          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "space_id",
            "in": "query",
            "required": false,
            "description": "Space ID read via `$request->getSafe()` in getTopSpaces().",
            "schema": {
              "type": "string",
              "default": "null"

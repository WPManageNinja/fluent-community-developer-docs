{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/moderation/config": {
      "post": {
        "operationId": "saveModerationConfig",
        "summary": "POST Save Moderation Config",
        "description": "Stores the content moderation configuration and keeps the `content_moderation` feature flag in step with its `is_enabled` value.\n\nController: `ModerationController@saveConfig`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:108`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "config": {
                    "type": "object",
                    "properties": {
                      "is_enabled": {
                        "type": "string"
                      },
                      "profanity_filter": {
                        "type": "string"
                      },
                      "flag_after_threshold": {
                        "type": "integer"
                      },
                      "first_comment_approval": {
                        "type": "string"
                      },
                      "auto_flag_user_reject_threshold": {
                        "type": "integer"
                      },
                      "auto_flag_user_report_threshold": {
                        "type": "integer"
                      }
                    },
                    "required": []
                  }
                }
              },
              "example": {
                "config": {
                  "auto_flag_user_reject_threshold": 0,
                  "auto_flag_user_report_threshold": 0,
                  "first_comment_approval": "no",
                  "first_post_approval": "yes",
                  "flag_after_threshold": 3,
                  "flag_all_new_posts": "no",
                  "flag_all_new_posts_spaces": [],
                  "is_enabled": "yes",
                  "profanity_filter": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "config": {
                      "type": "object",
                      "properties": {
                        "auto_flag_user_reject_threshold": {
                          "type": "integer"
                        },
                        "auto_flag_user_report_threshold": {
                          "type": "integer"
                        },
                        "first_comment_approval": {
                          "type": "string",
                          "nullable": false
                        },
                        "first_post_approval": {
                          "type": "string",
                          "nullable": false
                        },
                        "flag_after_threshold": {
                          "type": "integer"
                        },
                        "flag_all_new_posts": {
                          "type": "string",
                          "nullable": false
                        },
                        "flag_all_new_posts_spaces": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "is_enabled": {
                          "type": "string",
                          "nullable": false
                        },
                        "profanity_filter": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "config": {
                    "auto_flag_user_reject_threshold": 0,
                    "auto_flag_user_report_threshold": 0,
                    "first_comment_approval": "no",
                    "first_post_approval": "yes",
                    "flag_after_threshold": 3,
                    "flag_all_new_posts": "no",
                    "flag_all_new_posts_spaces": [],
                    "is_enabled": "yes",
                    "profanity_filter": ""
                  },
                  "message": "Just tried it and it works exactly as described."
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

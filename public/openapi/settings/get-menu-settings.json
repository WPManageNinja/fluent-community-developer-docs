                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "mainMenuItems": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "enabled": {
                                "type": "string",
                                "nullable": false
                              },
                              "is_locked": {
                                "type": "string",
                                "nullable": false
                              },
                              "is_system": {
                                "type": "string",
                                "nullable": false
                              },
                              "link_classes": {
                                "type": "string",
                                "nullable": false
                              },
                              "permalink": {
                                "type": "string",
                                "nullable": false
                              },
                              "shape_svg": {
                                "type": "string",
                                "nullable": false
                              },
                              "slug": {
                                "type": "string",
                                "nullable": false
                              },
                              "title": {
                                "type": "string",
                                "nullable": false

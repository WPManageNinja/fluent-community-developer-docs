                "schema": {
                  "type": "object",
                  "properties": {
                    "menuSettings": {
                      "type": "object",
                      "properties": {
                        "afterCommunityLinkGroups": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },

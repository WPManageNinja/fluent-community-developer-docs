{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/mcp/install-adapter": {
      "post": {
        "operationId": "installMcpAdapter",
        "summary": "POST Install MCP Adapter",
        "description": "Asks another Fluent plugin to install the MCP adapter, and returns the refreshed adapter state.\n\nController: `McpSettingsController@installAdapter`\nRoute source: `fluent-community/Modules/Mcp/Http/mcp_api.php:11`",
        "tags": [
          "Settings"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "settings": {
                      "type": "object",
                      "properties": {
                        "active": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "endpoint_url": {
                      "type": "string",
                      "nullable": false
                    },
                    "server_name": {
                      "type": "string",
                      "nullable": false
                    },
                    "adapter": {
                      "type": "object",
                      "properties": {
                        "installed": {
                          "type": "boolean"
                        },
                        "active": {
                          "type": "boolean"
                        },
                        "provider": {
                          "type": "string",
                          "nullable": false
                        },
                        "version": {
                          "type": "string",
                          "nullable": false
                        },
                        "abilities_api": {
                          "type": "boolean"
                        },
                        "can_auto_install": {
                          "type": "boolean"
                        },
                        "download_url": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "hub": {
                      "type": "string",
                      "nullable": true
                    },
                    "tools": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "pro": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    },
                    "pro_active": {
                      "type": "boolean"
                    },
                    "app_passwords_url": {
                      "type": "string",
                      "nullable": false
                    },
                    "plugins_url": {
                      "type": "string",
                      "nullable": false
                    },
                    "current_user_login": {
                      "type": "string",
                      "nullable": false
                    },
                    "is_local_dev": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "The MCP adapter is installed and active.",
                  "settings": {
                    "active": "yes"
                  },
                  "endpoint_url": "https://example.com/wp-json/fluent-community/mcp",
                  "server_name": "example-community",
                  "adapter": {
                    "installed": true,
                    "active": true,
                    "provider": "toolkit",
                    "version": "1.2.0",
                    "abilities_api": true,
                    "can_auto_install": false,
                    "download_url": "https://github.com/WPManageNinja/fluent-toolkit"
                  },
                  "hub": null,
                  "tools": {
                    "total": 23,
                    "pro": 9
                  },
                  "pro_active": true,
                  "app_passwords_url": "https://example.com/wp-admin/profile.php#application-passwords-section",
                  "plugins_url": "https://example.com/wp-admin/plugins.php",
                  "current_user_login": "community-admin",
                  "is_local_dev": false
                }
              }
            }
          },
          "403": {
            "description": "Sorry, you do not have permission to install plugins.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Sorry, you do not have permission to install plugins."
                }
              }
            }
          },
          "422": {
            "description": "Please install FluentHub, then reload this page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please install FluentHub, then reload this page."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/customization-settings": {
      "post": {
        "operationId": "saveCustomizationSettings",
        "summary": "POST Save Customization Settings",
        "description": "Stores the portal appearance settings, coercing each field to its expected shape.\n\nController: `SettingController@updateCustomizationSettings`\nRoute source: `fluent-community/app/Http/Routes/api.php:160`",
        "tags": [
          "Settings"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "settings": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "settings": {
                  "a11y_enhancement_style": "yes",
                  "affiliate_id": 69,
                  "collapse_sidebar_groups": "no",
                  "dark_mode": "yes",
                  "default_feed_layout": "timeline",
                  "default_feed_sort_by": "latest",
                  "default_theme_mode": "light",
                  "disable_feed_layout": "no",
                  "disable_feed_sort_by": "no",
                  "enable_sidebar_toggle": "no",
                  "feed_link_on_sidebar": "yes",
                  "fixed_page_header": "yes",
                  "fixed_sidebar": "no",
                  "hide_header_on_scroll": "no",
                  "icon_on_header_menu": "no",
                  "max_media_per_post": "4",
                  "member_list_layout": "grid",
                  "post_title_pref": "required",
                  "rich_post_layout": "classic",
                  "show_post_modal": "yes",
                  "show_powered_by": "yes"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "This is really helpful, thanks for writing it up."
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

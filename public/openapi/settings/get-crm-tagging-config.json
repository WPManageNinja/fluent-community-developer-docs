                          "nullable": false
                        },
                        "create_user": {
                          "type": "string",
                          "nullable": false
                        },
                        "has_course_sync": {
                          "type": "string",
                          "nullable": false
                        },
                        "has_course_tagging": {
                          "type": "string",
                          "nullable": false
                        },
                        "has_space_sync": {
                          "type": "string",
                          "nullable": false
                        },
                        "has_space_tagging": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_enabled": {
                          "type": "string",
                          "nullable": false
                        },
                        "linked_maps": {
                          "type": "object",
                          "properties": {
                            "8": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "send_welcome_email": {
                          "type": "string",
                          "nullable": false
                        },
                        "tagging_maps": {
                          "type": "object",
                          "properties": {
                            "8": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "spaceGroups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "spaces": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "icon": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "id": {
                                  "type": "integer"
                                },
                                "privacy": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "slug": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "title": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "type": {
                                  "type": "string",
                                  "nullable": false
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "title": {
                            "type": "string",
                            "nullable": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },

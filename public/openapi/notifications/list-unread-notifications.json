{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/notifications/unread": {
      "get": {
        "operationId": "listUnreadNotifications",
        "summary": "GET List Unread Notifications",
        "description": "Returns up to 50 unread notifications for the current user with the unread total, for the notification dropdown.\n\nController: `NotificationsController@getUnreadNotifications`\nRoute source: `fluent-community/app/Http/Routes/api.php:132`",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "notification_type",
            "in": "query",
            "required": false,
            "description": "Notification Type read via `$request->get()` in getUnreadNotifications().",
            "schema": {
              "type": "string",
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "action": {
                            "type": "string",
                            "nullable": false
                          },
                          "content": {
                            "type": "string",
                            "nullable": false
                          },
                          "created_at": {
                            "type": "string",
                            "nullable": false
                          },
                          "feed_id": {
                            "type": "string",
                            "nullable": false
                          },
                          "id": {
                            "type": "integer"
                          },
                          "object_id": {
                            "type": "string",
                            "nullable": false
                          },
                          "route": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "nullable": false
                              },
                              "params": {
                                "type": "object",
                                "properties": {
                                  "feed_slug": {
                                    "type": "string",
                                    "nullable": false
                                  },
                                  "space": {
                                    "type": "string",
                                    "nullable": false
                                  }
                                },
                                "additionalProperties": false
                              }
                            },
                            "additionalProperties": false
                          },
                          "src_object_type": {
                            "type": "string",
                            "nullable": false
                          },
                          "src_user_id": {
                            "type": "string",
                            "nullable": true
                          },
                          "title": {
                            "type": "string",
                            "nullable": true
                          },
                          "updated_at": {
                            "type": "string",
                            "nullable": false
                          },
                          "xprofile": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "unread_count": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "notifications": [
                    {
                      "action": "post_report_added",
                      "content": "This is really helpful, thanks for writing it up.",
                      "created_at": "2026-08-17 22:39:56",

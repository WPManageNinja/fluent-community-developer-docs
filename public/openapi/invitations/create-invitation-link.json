{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/invitations/link": {
      "post": {
        "operationId": "createInvitationLink",
        "summary": "POST Create Invitation Link",
        "description": "Create Invitation Link for the FluentCommunity Invitations API.\n\nController: `InvitationController@createNewLink`\nRoute source: `fluent-community/Modules/Auth/InvitationModule.php:26`",
        "tags": [
          "Invitations"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "space_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "expire_date": {
                    "type": "string"
                  }
                },
                "required": [
                  "space_id",
                  "title"
                ]
              },
              "example": {
                "expire_date": "",
                "limit": 0,
                "space_id": 92,
                "title": "Share your workflow setup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invitation": {
                      "type": "object",
                      "properties": {
                        "access_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "message_rendered": {
                          "type": "string",
                          "nullable": false
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "post_id": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "invitation": {
                    "access_url": "https://yourwebsite.com/portal/?fcom_action=auth&invitation_token=373b7f609db2d473ed11e07425ed5ce8",
                    "created_at": "2026-08-17 22:05:20",
                    "id": 59787,
                    "message_rendered": "<p>Just tried it and it works exactly as described.</p>",
                    "meta": {
                      "title": "Share your workflow setup"
                    },
                    "post_id": 92,
                    "status": "active",
                    "type": "invitation",
                    "updated_at": "2026-08-17 22:05:20",
                    "user_id": 1
                  },
                  "message": "Great point — I ran into the same thing last week."
                }
              }
            }
          },
          "422": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Error response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

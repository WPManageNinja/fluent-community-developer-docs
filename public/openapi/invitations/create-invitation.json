      "post": {
        "operationId": "createInvitation",
        "summary": "POST Create Invitation",
        "description": "Invites one email address to join a space and sends the invitation email immediately.\n\nController: `InvitationController@store`\nRoute source: `fluent-community/Modules/Auth/InvitationModule.php:25`",

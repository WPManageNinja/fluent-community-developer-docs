          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "space_id": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "invitee_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "space_id",
                  "email"
                ]
              },
              "example": {
                "email": "member@example.com",
                "invitee_name": "New Member",
                "space_id": 119
              }
            }

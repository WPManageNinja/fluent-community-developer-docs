{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/members/{user_id}": {
      "patch": {
        "operationId": "updateMember",
        "summary": "PATCH Update Member",
        "description": "Update Member for the FluentCommunity Members API.\n\nController: `MembersController@patchMember`\nRoute source: `fluent-community/app/Http/Routes/api.php:127`",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "description": "User ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "status": "active"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "member": {
                      "type": "object",
                      "properties": {
                        "avatar": {
                          "type": "string",
                          "nullable": false
                        },
                        "badge": {
                          "type": "string",
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "display_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_verified": {
                          "type": "integer"
                        },
                        "last_activity": {
                          "type": "string",
                          "nullable": true
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "badge_slug": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "cover_photo": {
                              "type": "string",
                              "nullable": false
                            },
                            "headline": {
                              "type": "string",
                              "nullable": false
                            },
                            "short_description_rendered": {
                              "type": "string",
                              "nullable": false
                            },
                            "website": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "permalink": {
                          "type": "string",
                          "nullable": false
                        },
                        "short_description": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "total_points": {
                          "type": "integer"
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "username": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "member": {
                    "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka_3.png",
                    "badge": null,
                    "created_at": "2026-08-17 21:31:52",
                    "display_name": "Mei Tanaka",
                    "id": "12393",
                    "is_verified": 0,
                    "last_activity": null,
                    "meta": {
                      "badge_slug": [],
                      "cover_photo": "",
                      "headline": "Product Designer",
                      "short_description_rendered": "<p>Designer and illustrator. I post work-in-progress shots.</p>",
                      "website": "https://example.com"
                    },
                    "permalink": "https://yourwebsite.com/portal/u/mei_tanaka_3",
                    "short_description": "Designer and illustrator. I post work-in-progress shots.",
                    "status": "active",
                    "total_points": 0,
                    "updated_at": "2026-08-17 21:56:17",
                    "user_id": 13096,
                    "username": "mei_tanaka_3"
                  },
                  "message": "This is really helpful, thanks for writing it up."
                }
              }
            }
          },
          "422": {
            "description": "Sorry, you cannot change the status of another admin. Remove the user from moderators",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Sorry, you cannot change the status of another admin. Remove the user from moderators"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

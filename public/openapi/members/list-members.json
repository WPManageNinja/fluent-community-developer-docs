  "paths": {
    "/members": {
      "get": {
        "operationId": "listMembers",
        "summary": "GET List Members",
        "description": "Returns a paginated directory of community members in the requested sort order, or the trimmed candidate list the mention autocomplete uses.\n\nController: `MembersController@getMembers`\nRoute source: `fluent-community/app/Http/Routes/api.php:130`",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "mention",
            "in": "query",
            "required": false,
            "description": "Mention read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "space",
            "in": "query",
            "required": false,
            "description": "Space read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "space_id",
            "in": "query",
            "required": false,
            "description": "Space ID read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "Sort By read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string",
              "default": "last_activity"
            }
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "Sort Dir read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Status read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string",
              "default": "active"

  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/spaces/{spaceSlug}/members": {
      "get": {
        "operationId": "listSpaceMembers",
        "summary": "GET List Space Members",
        "description": "Returns the paginated active membership of a space, each entry carrying the member profile and their role, plus the count of outstanding join requests.\n\nController: `SpaceController@getMembers`\nRoute source: `fluent-community/app/Http/Routes/api.php:18`",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "spaceSlug",
            "in": "path",
            "required": true,
            "description": "SpaceSlug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Status read via `$request->get()` in getMembers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "Sort By read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string",
              "default": "created_at"
            }
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "Sort Dir read via `$request->getSafe()` in getMembers().",
            "schema": {
              "type": "string"
            }

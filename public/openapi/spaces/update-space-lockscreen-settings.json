                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "community": {
                    "cover_photo": null,
                    "created_at": "2026-08-17 22:04:05",
                    "created_by": "1",
                    "description": "A place to introduce yourself and meet other members.",
                    "id": 92,
                    "logo": null,
                    "parent_id": "91",
                    "privacy": "public",
                    "serial": "1",
                    "settings": {
                      "can_request_join": "no",
                      "custom_lock_screen": "no",
                      "default_comment_sort_by": "",
                      "default_post_sort_by": "",
                      "disable_layout_style": "no",
                      "disable_post_sort_by": "no",
                      "document_access": "everybody",
                      "document_library": "yes",
                      "document_upload": "admin_only",
                      "emoji": "",
                      "hide_members_count": "no",
                      "layout_style": "timeline",
                      "links": [
                        {
                          "slug": "space-guidelines",
                          "title": "Space guidelines"
                        }
                      ],
                      "media_access": "everybody",
                      "media_gallery": "yes",
                      "members_page_status": "members_only",
                      "og_image": "",
                      "onboard_redirect_url": "",

                              "nullable": false
                            },
                            "default_comment_sort_by": {
                              "type": "string",
                              "nullable": false
                            },
                            "default_post_sort_by": {
                              "type": "string",
                              "nullable": false
                            },
                            "disable_layout_style": {
                              "type": "string",
                              "nullable": false
                            },
                            "disable_post_sort_by": {
                              "type": "string",
                              "nullable": false
                            },
                            "document_access": {
                              "type": "string",
                              "nullable": false
                            },
                            "document_library": {
                              "type": "string",
                              "nullable": false
                            },
                            "document_upload": {
                              "type": "string",
                              "nullable": false
                            },
                            "emoji": {
                              "type": "string",
                              "nullable": false
                            },
                            "hide_members_count": {
                              "type": "string",
                              "nullable": false
                            },
                            "layout_style": {
                              "type": "string",
                              "nullable": false
                            },
                            "links": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "slug": {
                                    "type": "string",
                                    "nullable": false
                                  },
                                  "title": {
                                    "type": "string",
                                    "nullable": false
                                  }

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/spaces/{spaceSlug}/lockscreens": {
      "put": {
        "operationId": "updateSpaceLockscreenSettings",
        "summary": "PUT Update Space Lockscreen Settings",
        "description": "Update Space Lockscreen Settings for the FluentCommunity Spaces API.\n\nController: `ProAdminController@updateSpaceLockscreenSettings`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:59`",
        "tags": [
          "Spaces"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "spaceSlug",
            "in": "path",
            "required": true,
            "description": "SpaceSlug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lockscreen": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "lockscreen_config": {
                  "button_text": "Join now",
                  "description": "Join this space to see the discussions.",
                  "title": "Members only"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "community": {
                      "type": "object",
                      "properties": {
                        "cover_photo": {
                          "type": "string",
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_by": {
                          "type": "string",
                          "nullable": false
                        },
                        "description": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "logo": {
                          "type": "string",
                          "nullable": true
                        },
                        "parent_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "privacy": {
                          "type": "string",
                          "nullable": false
                        },
                        "serial": {
                          "type": "string",
                          "nullable": false
                        },

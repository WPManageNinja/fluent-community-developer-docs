                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title",
                      "privacy"
                    ]
                  }
                }
              },
              "example": {
                "space": {
                  "description": "A place to introduce yourself and meet other members.",
                  "parent_id": 109,
                  "privacy": "public",
                  "settings": {
                    "can_create_post": "all",
                    "custom_lock_screen": "no",
                    "document_access": "everybody",
                    "document_library": "yes",
                    "emoji": "",

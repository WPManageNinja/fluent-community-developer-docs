{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/spaces/{spaceSlug}/lockscreens": {
      "get": {
        "operationId": "getSpaceLockscreens",
        "summary": "GET Get Space Lockscreens",
        "description": "Get Space Lockscreens for the FluentCommunity Spaces API.\n\nController: `SpaceController@getLockScreenSettings`\nRoute source: `fluent-community/app/Http/Routes/api.php:25`",
        "tags": [
          "Spaces"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "spaceSlug",
            "in": "path",
            "required": true,
            "description": "SpaceSlug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lockscreen": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "background_image": {
                            "type": "string",
                            "nullable": false
                          },
                          "button_color": {
                            "type": "string",
                            "nullable": false
                          },
                          "button_link": {
                            "type": "string",
                            "nullable": false
                          },
                          "button_text": {
                            "type": "string",
                            "nullable": false
                          },
                          "button_text_color": {
                            "type": "string",
                            "nullable": false
                          },
                          "description": {
                            "type": "string",
                            "nullable": false
                          },
                          "heading": {
                            "type": "string",
                            "nullable": false
                          },
                          "heading_color": {
                            "type": "string",
                            "nullable": false
                          },
                          "hidden": {
                            "type": "boolean"
                          },
                          "label": {
                            "type": "string",
                            "nullable": false
                          },
                          "name": {
                            "type": "string",
                            "nullable": false
                          },
                          "new_tab": {
                            "type": "string",
                            "nullable": false
                          },
                          "overlay_color": {
                            "type": "string",
                            "nullable": false
                          },
                          "text_color": {
                            "type": "string",
                            "nullable": false
                          },
                          "type": {
                            "type": "string",
                            "nullable": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "lockscreen": [
                    {
                      "background_image": "",
                      "button_color": "#2B2E33",
                      "button_link": "",
                      "button_text": "Buy Now",
                      "button_text_color": "#FFFFFF",
                      "description": "Share what you are building and get feedback from other members.",
                      "heading": "Welcome to the community",
                      "heading_color": "#FFFFFF",
                      "hidden": false,
                      "label": "Banner",
                      "name": "banner",
                      "new_tab": "no",
                      "overlay_color": "#798398",
                      "text_color": "#FFFFFF",
                      "type": "image"
                    },
                    {
                      "content": "Great point — I ran into the same thing last week.",
                      "hidden": false,
                      "label": "Description",
                      "name": "description",
                      "type": "block"
                    },
                    {
                      "background_image": "",
                      "button_color": "#2B2E33",
                      "button_link": "",
                      "button_text": "Buy Now",
                      "button_text_color": "#FFFFFF",
                      "description": "A place to introduce yourself and meet other members.",
                      "heading": "Feature request round-up",
                      "heading_color": "#FFFFFF",
                      "hidden": false,
                      "label": "Call to action",
                      "name": "action",
                      "new_tab": "no",
                      "overlay_color": "#798398",
                      "text_color": "#FFFFFF",
                      "type": "image"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Space not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Space not found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

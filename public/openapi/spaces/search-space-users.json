{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/spaces/users/search": {
      "get": {
        "operationId": "searchSpaceUsers",
        "summary": "GET Search Space Users",
        "description": "Search Space Users for the FluentCommunity Spaces API.\n\nController: `SpaceController@getOtherUsers`\nRoute source: `fluent-community/app/Http/Routes/api.php:29`",
        "tags": [
          "Spaces"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "space_id",
            "in": "query",
            "required": true,
            "description": "Space ID read via `$request->get()` in getOtherUsers(). Space ID validated in getOtherUsers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getOtherUsers().",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ID": {
                                "type": "integer"
                              },
                              "display_name": {
                                "type": "string",
                                "nullable": false
                              },
                              "photo": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_email": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "first_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "from": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "active": {
                                "type": "boolean"
                              },
                              "label": {
                                "type": "string",
                                "nullable": false
                              },
                              "url": {
                                "type": "string",
                                "nullable": true
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "path": {
                          "type": "string",
                          "nullable": false
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "users": {
                    "current_page": 1,
                    "data": [
                      {
                        "ID": 2,
                        "display_name": "Ivan Petrov",
                        "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/member.png",
                        "user_email": "member@example.com"
                      },
                      {
                        "ID": 3,
                        "display_name": "Ruby Callahan",
                        "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/member.png",
                        "user_email": "member@example.com"
                      },
                      {
                        "ID": 4,
                        "display_name": "Ivan Petrov",
                        "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/member.png",
                        "user_email": "member@example.com"
                      }
                    ],
                    "first_page_url": "https://yourwebsite.com/?page=1",
                    "from": 1,
                    "last_page": 1,
                    "last_page_url": "https://yourwebsite.com/?page=1",
                    "links": [
                      {
                        "active": false,
                        "label": "pagination.previous",
                        "url": null
                      },
                      {
                        "active": true,
                        "label": "1",
                        "url": "https://yourwebsite.com/?page=1"
                      },
                      {
                        "active": false,
                        "label": "pagination.next",
                        "url": null
                      }
                    ],
                    "next_page_url": null,
                    "path": "https://yourwebsite.com",
                    "per_page": 100,
                    "prev_page_url": null,
                    "to": 100,
                    "total": 100
                  }
                }
              }
            }
          },
          "422": {
            "description": "You are not allowed to add members to this space",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You are not allowed to add members to this space"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

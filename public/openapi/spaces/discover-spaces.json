            "name": "type",
            "in": "query",
            "required": false,
            "description": "Type read via `$request->getSafe()` in discover().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in discover().",

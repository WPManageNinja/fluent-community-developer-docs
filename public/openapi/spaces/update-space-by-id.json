{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/spaces/{spaceId}/by-id": {
      "put": {
        "operationId": "updateSpaceById",
        "summary": "PUT Update Space By ID",
        "description": "Updates a space addressed by numeric id; the id is resolved to a slug and then handled exactly as the by-slug endpoint.\n\nController: `SpaceController@patchById`\nRoute source: `fluent-community/app/Http/Routes/api.php:12`",
        "tags": [
          "Spaces"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "description": "SpaceId extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "privacy": {
                        "type": "string",
                        "nullable": false
                      },
                      "settings": {
                        "type": "object",
                        "properties": {
                          "can_create_post": {
                            "type": "string",
                            "nullable": false
                          },
                          "custom_lock_screen": {
                            "type": "string",
                            "nullable": false
                          },
                          "document_access": {
                            "type": "string",
                            "nullable": false
                          },
                          "document_library": {
                            "type": "string",
                            "nullable": false
                          },
                          "emoji": {
                            "type": "string",
                            "nullable": false
                          },
                          "hide_members_count": {
                            "type": "string",
                            "nullable": false
                          },
                          "layout_style": {
                            "type": "string",
                            "nullable": false
                          },
                          "media_access": {
                            "type": "string",
                            "nullable": false
                          },
                          "media_gallery": {
                            "type": "string",
                            "nullable": false
                          },
                          "restricted_post_only": {
                            "type": "string",
                            "nullable": false
                          },
                          "shape_svg": {
                            "type": "string",
                            "nullable": false
                          }
                        },
                        "additionalProperties": false
                      },
                      "title": {
                        "type": "string",
                        "nullable": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "data": {
                  "privacy": "private",
                  "settings": {
                    "can_create_post": "all",
                    "custom_lock_screen": "no",
                    "document_access": "everybody",
                    "document_library": "yes",
                    "emoji": "",
                    "hide_members_count": "no",
                    "layout_style": "timeline",
                    "media_access": "everybody",
                    "media_gallery": "yes",
                    "restricted_post_only": "no",
                    "shape_svg": ""
                  },
                  "title": "Product Feedback"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "redirect_url": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Just tried it and it works exactly as described.",
                  "redirect_url": ""
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

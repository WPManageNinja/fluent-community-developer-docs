{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/feeds/{feed_id}/comments/{comment_id}": {
      "patch": {
        "operationId": "patchComment",
        "summary": "PATCH Patch Comment",
        "description": "Patch Comment for the FluentCommunity Comments API.\n\nController: `CommentsController@patchComment`\nRoute source: `fluent-community/app/Http/Routes/api.php:55`",
        "tags": [
          "Comments"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "feed_id",
            "in": "path",
            "required": true,
            "description": "Feed ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "comment_id",
            "in": "path",
            "required": true,
            "description": "Comment ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "comment": {
                      "type": "object",
                      "properties": {
                        "content_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "is_sticky": {
                          "type": "integer"
                        },
                        "message": {
                          "type": "string",
                          "nullable": false
                        },
                        "message_rendered": {
                          "type": "string",
                          "nullable": false
                        },
                        "meta": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "parent_id": {
                          "type": "string",
                          "nullable": true
                        },
                        "post_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "reactions_count": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "comment": {
                    "content_type": "text",
                    "created_at": "2026-08-17 22:04:05",
                    "id": 59781,
                    "is_sticky": 0,
                    "message": "Following. I would love to see a worked example of this.",
                    "message_rendered": "<p>Just tried it and it works exactly as described.</p>",
                    "meta": [],
                    "parent_id": null,
                    "post_id": "15008",
                    "reactions_count": "0",
                    "status": "published",
                    "type": "comment",
                    "updated_at": "2026-08-17 22:05:20",
                    "user_id": "1"
                  },
                  "message": "This is really helpful, thanks for writing it up."
                }
              }
            }
          },
          "422": {
            "description": "You cannot pin a reply comment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You cannot pin a reply comment"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

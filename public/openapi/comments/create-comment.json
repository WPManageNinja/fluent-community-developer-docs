{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/feeds/{feed_id}/comments": {
      "post": {
        "operationId": "createComment",
        "summary": "POST Create Comment",
        "description": "Create Comment for the FluentCommunity Comments API.\n\nController: `CommentsController@store`\nRoute source: `fluent-community/app/Http/Routes/api.php:53`",
        "tags": [
          "Comments"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "feed_id",
            "in": "path",
            "required": true,
            "description": "Feed ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "comment": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "media": {
                          "type": "string",
                          "nullable": true
                        },
                        "message": {
                          "type": "string",
                          "nullable": false
                        },
                        "message_rendered": {
                          "type": "string",
                          "nullable": false
                        },
                        "meta": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "post_id": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "xprofile": {
                          "type": "object",
                          "properties": {
                            "avatar": {
                              "type": "string",
                              "nullable": false
                            },
                            "badge": {
                              "type": "string",
                              "nullable": true
                            },
                            "created_at": {
                              "type": "string",
                              "nullable": false
                            },
                            "display_name": {
                              "type": "string",
                              "nullable": false
                            },
                            "is_verified": {
                              "type": "integer"
                            },
                            "last_activity": {
                              "type": "string",
                              "nullable": false
                            },
                            "meta": {
                              "type": "object",
                              "properties": {
                                "badge_slug": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "cover_photo": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "social_links": {
                                  "type": "object",
                                  "properties": {
                                    "fb": {
                                      "type": "string",
                                      "nullable": false
                                    },
                                    "instagram": {
                                      "type": "string",
                                      "nullable": false
                                    },
                                    "linkedin": {
                                      "type": "string",
                                      "nullable": false
                                    },
                                    "twitter": {
                                      "type": "string",
                                      "nullable": false
                                    },
                                    "youtube": {
                                      "type": "string",
                                      "nullable": false
                                    }
                                  },
                                  "additionalProperties": false
                                },
                                "website": {
                                  "type": "string",
                                  "nullable": false
                                }
                              },
                              "additionalProperties": false
                            },
                            "permalink": {
                              "type": "string",
                              "nullable": false
                            },
                            "short_description": {
                              "type": "string",
                              "nullable": false
                            },
                            "status": {
                              "type": "string",
                              "nullable": false
                            },
                            "total_points": {
                              "type": "integer"
                            },
                            "user_id": {
                              "type": "integer"
                            },
                            "username": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "comment": {
                    "created_at": "2026-08-17 22:04:05",
                    "id": 59781,
                    "media": null,
                    "message": "This is really helpful, thanks for writing it up.",
                    "message_rendered": "<p>Following. I would love to see a worked example of this.</p>",
                    "meta": [],
                    "post_id": 15008,
                    "status": "published",
                    "type": "comment",
                    "updated_at": "2026-08-17 22:04:05",
                    "user_id": 1,
                    "xprofile": {
                      "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/alex_rivera.png",
                      "badge": null,
                      "created_at": "2024-03-05 16:37:02",
                      "display_name": "Alex Rivera",
                      "is_verified": 1,
                      "last_activity": "2026-08-17 22:00:34",
                      "meta": {
                        "badge_slug": "admin",
                        "cover_photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/covers/cover.jpg",
                        "social_links": {
                          "fb": "alexrivera",
                          "instagram": "alexrivera",
                          "linkedin": "alexrivera",
                          "twitter": "alexrivera",
                          "youtube": "alexrivera"
                        },
                        "website": "https://example.com"
                      },
                      "permalink": "https://yourwebsite.com/portal/u/alex_rivera",
                      "short_description": "Community builder. Helping members get the most out of the platform.",
                      "status": "active",
                      "total_points": 20385,
                      "user_id": 1,
                      "username": "alex_rivera"
                    }
                  },
                  "message": "Just tried it and it works exactly as described."
                }
              }
            }
          },
          "422": {
            "description": "The comment is too long. Please keep it under %s characters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "The comment is too long. Please keep it under %s characters."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

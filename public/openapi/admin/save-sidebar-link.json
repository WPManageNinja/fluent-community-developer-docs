{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/links": {
      "post": {
        "operationId": "saveSidebarLink",
        "summary": "POST Save Sidebar Link",
        "description": "Creates or updates a custom sidebar link inside a space group, including its icon, target and visibility rule.\n\nController: `ProAdminController@saveSidebarLink`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:57`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "link": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "parent_id": {
                        "type": "string"
                      },
                      "privacy": {
                        "type": "string"
                      },
                      "settings": {
                        "type": "object",
                        "properties": {
                          "permalink": {
                            "type": "string"
                          },
                          "membership_ids": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "permalink"
                        ]
                      }
                    },
                    "required": [
                      "title",
                      "parent_id",
                      "privacy"
                    ]
                  }
                }
              },
              "example": {
                "link": {
                  "parent_id": 118,
                  "privacy": "public",
                  "settings": {
                    "emoji": "",
                    "new_tab": "yes",
                    "permalink": "https://example.com/docs",
                    "shape_svg": ""
                  },
                  "title": "Help Centre"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_by": {
                          "type": "integer"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "parent_id": {
                          "type": "integer"
                        },
                        "privacy": {
                          "type": "string",
                          "nullable": false
                        },
                        "serial": {
                          "type": "integer"
                        },
                        "settings": {
                          "type": "object",
                          "properties": {
                            "emoji": {
                              "type": "string",
                              "nullable": false
                            },
                            "membership_ids": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "new_tab": {
                              "type": "string",
                              "nullable": false
                            },
                            "permalink": {
                              "type": "string",
                              "nullable": false
                            },
                            "shape_svg": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "link": {
                    "created_at": "2026-08-17 22:41:10",
                    "created_by": 1,
                    "id": 126,
                    "parent_id": 118,
                    "privacy": "public",
                    "serial": 3,
                    "settings": {
                      "emoji": "",
                      "membership_ids": [],
                      "new_tab": "yes",
                      "permalink": "https://example.com/docs",
                      "shape_svg": ""
                    },
                    "slug": "custom_help-centre_1787006470",
                    "status": "published",
                    "title": "Help Centre",
                    "type": "sidebar_link",
                    "updated_at": "2026-08-17 22:41:10"
                  },
                  "message": "This is really helpful, thanks for writing it up."
                }
              }
            }
          },
          "422": {
            "description": "Please select at least one membership for members only link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please select at least one membership for members only link"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

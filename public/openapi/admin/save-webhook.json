{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/webhooks": {
      "post": {
        "operationId": "saveWebhook",
        "summary": "POST Save Webhook",
        "description": "Save Webhook for the FluentCommunity Admin API.\n\nController: `ProAdminController@saveWebhook`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:51`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "course_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "space_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "remove_course_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "remove_space_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "send_wp_welcome_email": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ]
              },
              "example": {
                "course_ids": [
                  96
                ],
                "send_wp_welcome_email": "no",
                "space_ids": [
                  92
                ],
                "title": "CRM Sync"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "webhook": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "meta_key": {
                          "type": "string",
                          "nullable": false
                        },
                        "object_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "value": {
                          "type": "object",
                          "properties": {
                            "course_ids": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            },
                            "remove_course_ids": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "remove_space_ids": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "send_wp_welcome_email": {
                              "type": "string",
                              "nullable": false
                            },
                            "space_ids": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            },
                            "title": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "webhook_url": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Great point — I ran into the same thing last week.",
                  "webhook": {
                    "created_at": "2026-08-17 22:05:22",
                    "id": 25064,
                    "meta_key": "19932c80b30c27b36ac830fe3b2fc09455915aaffe29ab9a62c338993c02d441",
                    "object_type": "webhook",
                    "updated_at": "2026-08-17 22:05:22",
                    "value": {
                      "course_ids": [
                        96
                      ],
                      "remove_course_ids": [],
                      "remove_space_ids": [],
                      "send_wp_welcome_email": "no",
                      "space_ids": [
                        92
                      ],
                      "title": "CRM Sync"
                    },
                    "webhook_url": "https://yourwebsite.com/portal/?fcom_action=incoming_webhook&webhook=19932c80b30c27b36ac830fe3b2fc09455915aaffe29ab9a62c338993c02d441"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Webhook not found."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

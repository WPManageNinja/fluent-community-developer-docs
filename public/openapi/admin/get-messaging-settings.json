{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/messaging-setting": {
      "get": {
        "operationId": "getMessagingSettings",
        "summary": "GET Get Messaging Settings",
        "description": "Returns the direct-messaging configuration alongside the realtime socket credentials used by the chat client.\n\nController: `ProAdminController@getMessagingSettings`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:21`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "object",
                      "properties": {
                        "messaging_email_frequency": {
                          "type": "string",
                          "nullable": false
                        },
                        "messaging_email_status": {
                          "type": "string",
                          "nullable": false
                        },
                        "points_to_initiate_message": {
                          "type": "integer"
                        },
                        "realtime_enabled": {
                          "type": "string",
                          "nullable": false
                        },
                        "socket_provider": {
                          "type": "string",
                          "nullable": false
                        },
                        "who_can_initiate_message": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "socket_config": {
                      "type": "object",
                      "properties": {
                        "appId": {
                          "type": "string",
                          "nullable": false
                        },
                        "cluster": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_defined": {
                          "type": "boolean"
                        },
                        "key": {
                          "type": "string",
                          "nullable": false
                        },
                        "options": {
                          "type": "object",
                          "properties": {
                            "host": {
                              "type": "string",
                              "nullable": false
                            },
                            "port": {
                              "type": "integer"
                            },
                            "scheme": {
                              "type": "string",
                              "nullable": false
                            },
                            "useTLS": {
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "provider": {
                          "type": "string",
                          "nullable": false
                        },
                        "secret": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "settings": {
                    "messaging_email_frequency": "hourly",
                    "messaging_email_status": "yes",
                    "points_to_initiate_message": 20,
                    "realtime_enabled": "yes",
                    "socket_provider": "fluent-socket",
                    "who_can_initiate_message": "everyone"
                  },
                  "socket_config": {
                    "appId": "2",
                    "cluster": "mt1",
                    "is_defined": false,
                    "key": "app_xxxxxxxxxxxxxxxx",
                    "options": {
                      "host": "ws.fluentsocket.com",
                      "port": 443,
                      "scheme": "https",
                      "useTLS": true
                    },
                    "provider": "fluent-socket",
                    "secret": false
                  }
                }
              }
            }
          },
          "422": {
            "description": "Please update Fluent Messaging plugin to latest version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please update Fluent Messaging plugin to latest version"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/managers": {
      "post": {
        "operationId": "saveAdminManager",
        "summary": "POST Save Admin Manager",
        "description": "Grants or replaces the FluentCommunity role set for one WordPress user, creating their community profile if they do not have one yet.\n\nController: `ProAdminController@addOrUpdateManager`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:11`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "user_id",
                  "roles"
                ]
              },
              "example": {
                "permissions": [
                  "space_management"
                ],
                "user_id": 13097
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "manager": {
                      "type": "object",
                      "properties": {
                        "ID": {
                          "type": "integer"
                        },
                        "community_role": {
                          "type": "object",
                          "properties": {
                            "created_at": {
                              "type": "string",
                              "nullable": false
                            },
                            "id": {
                              "type": "integer"
                            },
                            "meta_key": {
                              "type": "string",
                              "nullable": false
                            },
                            "object_id": {
                              "type": "string",
                              "nullable": false
                            },
                            "object_type": {
                              "type": "string",
                              "nullable": false
                            },
                            "updated_at": {
                              "type": "string",
                              "nullable": false
                            },
                            "value": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            }
                          },
                          "additionalProperties": false
                        },
                        "display_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "photo": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_email": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_login": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_nicename": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_registered": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_status": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_url": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "manager": {
                    "ID": 13097,
                    "community_role": {
                      "created_at": "2026-08-17 22:41:10",
                      "id": 25090,
                      "meta_key": "_user_community_roles",
                      "object_id": "13097",
                      "object_type": "user",
                      "updated_at": "2026-08-17 22:41:10",
                      "value": []
                    },
                    "display_name": "Mei Tanaka",
                    "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka.png",
                    "user_email": "mei.tanaka@example.com",
                    "user_login": "mei_tanaka",
                    "user_nicename": "mei_tanaka",
                    "user_registered": "2026-08-17 21:31:53",
                    "user_status": "0",
                    "user_url": ""
                  },
                  "message": "Following. I would love to see a worked example of this."
                }
              }
            }
          },
          "404": {
            "description": "The selected user could not be found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "The selected user could not be found."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

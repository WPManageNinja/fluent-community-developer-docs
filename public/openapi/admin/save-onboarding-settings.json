{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/on-boardings": {
      "post": {
        "operationId": "saveOnboardingSettings",
        "summary": "POST Save Onboarding Settings",
        "description": "Applies the setup wizard answers — site title, logo, portal slug and starter content — and kicks off the optional plugin installs.\n\nController: `AdminController@saveOnBoardingSettings`\nRoute source: `fluent-community/app/Http/Routes/api.php:115`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "settings": {
                    "type": "object",
                    "properties": {
                      "site_title": {
                        "type": "string"
                      },
                      "logo": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "subscribe_to_newsletter": {
                        "type": "string"
                      },
                      "share_data": {
                        "type": "string"
                      },
                      "user_full_name": {
                        "type": "string"
                      },
                      "user_email_address": {
                        "type": "string"
                      },
                      "template": {
                        "type": "string"
                      },
                      "install_fluentcrm": {
                        "type": "string"
                      },
                      "install_fluentsmtp": {
                        "type": "string"
                      },
                      "install_fluentcart": {
                        "type": "string"
                      }
                    },
                    "required": []
                  }
                }
              },
              "example": {
                "settings": {
                  "access": {
                    "acess_level": "public"
                  },
                  "auth_content": "Please login first to access this page",
                  "auth_form_type": "default",
                  "auth_redirect": "",
                  "auth_url": "https://yourwebsite.com/",
                  "custom_signup_url": "",
                  "cutsom_auth_url": "https://yourwebsite.com/portal/?fcom_action=auth",
                  "disable_global_posts": "yes",
                  "explicit_registration": "no",
                  "featured_image": "https://cdn.yourwebsite.com/uploads/Fluent-Community-Featured-image.png",
                  "has_fluentcart": "yes",
                  "has_fluentcrm": "yes",
                  "has_fluentsmtp": "yes",
                  "install_fluentcart": "yes",
                  "install_fluentcrm": "yes",
                  "install_fluentsmtp": "yes",
                  "is_slug_defined": true,
                  "logo": "https://cdn.yourwebsite.com/uploads/cropped-your-company_logo_icon-1-1.webp",
                  "logo_permalink": "",
                  "logo_permalink_type": "default",
                  "notice_html": "",
                  "restricted_role_content": "Sorry, you can not access to this page. Only authorized users can access this page.",
                  "share_data": "no",
                  "site_title": "Your Community",
                  "slug": "portal",
                  "subscribe_to_newsletter": "yes",
                  "template": "",
                  "use_custom_signup_page": "no",
                  "user_email_address": "member@example.com",
                  "user_full_name": "Mei Tanaka",
                  "white_logo": "https://cdn.yourwebsite.com/uploads/cropped-your-company_logo_icon-1-1.webp"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Great point — I ran into the same thing last week."
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

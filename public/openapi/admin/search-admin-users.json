{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/users": {
      "get": {
        "operationId": "searchAdminUsers",
        "summary": "GET Search Admin Users",
        "description": "Searches WordPress users for the admin pickers, returning a paginated list matched on name, login and email.\n\nController: `ProAdminController@getUsers`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:13`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getUsers().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "context",
            "in": "query",
            "required": false,
            "description": "Context read via `$request->get()` in getUsers().",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ID": {
                                "type": "integer"
                              },
                              "display_name": {
                                "type": "string",
                                "nullable": false
                              },
                              "photo": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_email": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_login": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_nicename": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_registered": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_status": {
                                "type": "string",
                                "nullable": false
                              },
                              "user_url": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "first_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "from": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "active": {
                                "type": "boolean"
                              },
                              "label": {
                                "type": "string",
                                "nullable": false
                              },
                              "url": {
                                "type": "string",
                                "nullable": true
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "path": {
                          "type": "string",
                          "nullable": false
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "users": {
                    "current_page": 1,
                    "data": [
                      {
                        "ID": 1,
                        "display_name": "Lucas Moreau",
                        "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/lucas_moreau.png",
                        "user_email": "lucas.moreau@example.com",
                        "user_login": "lucas_moreau",
                        "user_nicename": "lucas_moreau",
                        "user_registered": "2024-03-05 10:37:02",
                        "user_status": "0",
                        "user_url": "https://example.com"
                      },
                      {
                        "ID": 2,

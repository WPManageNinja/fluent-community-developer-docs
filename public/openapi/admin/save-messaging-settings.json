{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/messaging-setting": {
      "post": {
        "operationId": "saveMessagingSettings",
        "summary": "POST Save Messaging Settings",
        "description": "Merges the submitted messaging settings over the stored ones and saves the realtime socket credentials when realtime chat is switched on.\n\nController: `ProAdminController@updateMessagingSettings`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:20`",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "settings": {
                    "type": "object",
                    "properties": {
                      "realtime_enabled": {
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "socket_config": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "settings": {
                  "messaging_email_frequency": "hourly",
                  "messaging_email_status": "yes",
                  "points_to_initiate_message": 20,
                  "realtime_enabled": "yes",
                  "socket_provider": "fluent-socket",
                  "who_can_initiate_message": "everyone"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "settings": {
                      "type": "object",
                      "properties": {
                        "messaging_email_frequency": {
                          "type": "string",
                          "nullable": false
                        },
                        "messaging_email_status": {
                          "type": "string",
                          "nullable": false
                        },
                        "points_to_initiate_message": {
                          "type": "integer"
                        },
                        "realtime_enabled": {
                          "type": "string",
                          "nullable": false
                        },
                        "socket_provider": {
                          "type": "string",
                          "nullable": false
                        },
                        "who_can_initiate_message": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Great point — I ran into the same thing last week.",
                  "settings": {
                    "messaging_email_frequency": "hourly",
                    "messaging_email_status": "yes",
                    "points_to_initiate_message": 20,
                    "realtime_enabled": "yes",
                    "socket_provider": "fluent-socket",
                    "who_can_initiate_message": "everyone"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

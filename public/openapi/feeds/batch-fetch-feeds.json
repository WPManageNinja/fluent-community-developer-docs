              "schema": {
                "type": "object",
                "properties": {
                  "feed_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "feed_ids": [
                  15046,
                  15047
                ]
              }
            }

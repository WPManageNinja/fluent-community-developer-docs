{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/feeds/oembed": {
      "get": {
        "operationId": "getOembed",
        "summary": "GET Get OEmbed",
        "description": "Get OEmbed for the FluentCommunity Feeds API.\n\nController: `FeedsController@getOembed`\nRoute source: `fluent-community/app/Http/Routes/api.php:68`",
        "tags": [
          "Feeds"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "URL read via `$request->get()` in getOembed().",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "oembed": {
                      "type": "object",
                      "properties": {
                        "author_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "content_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "html": {
                          "type": "string",
                          "nullable": false
                        },
                        "image": {
                          "type": "string",
                          "nullable": false
                        },
                        "provider": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "url": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "oembed": {
                    "author_name": "Hannah Lindqvist",
                    "content_type": "video",
                    "html": "<iframe width=\"500\" height=\"281\" src=\"https://www.youtube.com/embed/dQw4w9WgXcQ?feature=oembed\" frameborder=\"0\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen title=\"Omar Astley - Never Gonna Give You Up (Official Video) (4K Remaster)\"></iframe>",
                    "image": "https://i.ytimg.com/vi_webp/dQw4w9WgXcQ/maxresdefault.webp",
                    "provider": "youtube",
                    "title": "Community guidelines refresh",
                    "type": "oembed",
                    "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                  }
                }
              }
            }
          },
          "422": {
            "description": "No oembed data found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "No oembed data found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

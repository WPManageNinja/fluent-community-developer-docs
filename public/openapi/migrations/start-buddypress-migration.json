{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/migrations/buddypress/start": {
      "post": {
        "operationId": "startBuddypressMigration",
        "summary": "POST Start Buddypress Migration",
        "description": "Start Buddypress Migration for the FluentCommunity Migrations API.\n\nController: `BPMigrationController@startMigration`\nRoute source: `fluent-community/Modules/Migrations/Http/migration_api.php:15`",
        "tags": [
          "Migrations"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reset_migration": {
                    "type": "string"
                  },
                  "delete_current_data": {
                    "type": "string"
                  },
                  "config": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "reset_migration": "no",
                "delete_current_data": "no",
                "config": {
                  "1": 3,
                  "2": 3
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current_status": {
                      "type": "object",
                      "properties": {
                        "migrated_groups": {
                          "type": "object",
                          "properties": {
                            "1": {
                              "type": "integer"
                            },
                            "2": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "last_activity_id": {
                          "type": "integer"
                        },
                        "last_migrated_member_id": {
                          "type": "integer"
                        },
                        "migrated_posts_count": {
                          "type": "integer"
                        },
                        "last_migrated_user_id": {
                          "type": "integer"
                        },
                        "current_stage": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "max_ids": {
                      "type": "object",
                      "properties": {
                        "group_member_max": {
                          "type": "string",
                          "nullable": false
                        },
                        "max_user_id": {
                          "type": "integer"
                        },
                        "max_activity_id": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "current_status": {
                    "migrated_groups": {
                      "1": 14,
                      "2": 15
                    },
                    "last_activity_id": 0,
                    "last_migrated_member_id": 0,
                    "migrated_posts_count": 0,
                    "last_migrated_user_id": 0,
                    "current_stage": "group_members"
                  },
                  "max_ids": {
                    "group_member_max": "60",
                    "max_user_id": 57,
                    "max_activity_id": "496"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/migrations/buddypress/status": {
      "get": {
        "operationId": "getBuddypressMigrationStatus",
        "summary": "GET Get Buddypress Migration Status",
        "description": "Advances the migration by one time-boxed batch and returns the updated progress record — this endpoint does the work, it does not merely report on it.\n\nController: `BPMigrationController@getPollingStatus`\nRoute source: `fluent-community/Modules/Migrations/Http/migration_api.php:16`",
        "tags": [
          "Migrations"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "migrated_groups": {
                      "type": "object",
                      "properties": {
                        "1": {
                          "type": "integer"
                        },
                        "2": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    },
                    "last_activity_id": {
                      "type": "string",
                      "nullable": false
                    },
                    "last_migrated_member_id": {
                      "type": "string",
                      "nullable": false
                    },
                    "migrated_posts_count": {
                      "type": "integer"
                    },
                    "last_migrated_user_id": {
                      "type": "integer"
                    },
                    "current_stage": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "migrated_groups": {
                    "1": 14,
                    "2": 15
                  },
                  "last_activity_id": "496",
                  "last_migrated_member_id": "60",
                  "migrated_posts_count": 0,
                  "last_migrated_user_id": 0,
                  "current_stage": "users"
                }
              }
            }
          },
          "422": {
            "description": "Invalid stage. Please start the migration again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Invalid stage. Please start the migration again."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

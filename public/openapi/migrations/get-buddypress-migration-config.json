{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/migrations/buddypress/config": {
      "get": {
        "operationId": "getBuddypressMigrationConfig",
        "summary": "GET Get Buddypress Migration Config",
        "description": "Returns everything the migration wizard needs before it starts: the BuddyPress groups with their member counts and migrated state, the source data statistics, and any previously saved progress.\n\nController: `BPMigrationController@getMigrationConfig`\nRoute source: `fluent-community/Modules/Migrations/Http/migration_api.php:14`",
        "tags": [
          "Migrations"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groupItems": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "nullable": false
                          },
                          "name": {
                            "type": "string",
                            "nullable": false
                          },
                          "members_count": {
                            "type": "integer"
                          },
                          "is_migrated": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "featureConfig": {
                      "type": "object",
                      "properties": {
                        "has_groups": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "stats": {
                      "type": "object",
                      "properties": {
                        "groups": {
                          "type": "integer"
                        },
                        "total_posts": {
                          "type": "integer"
                        },
                        "total_comments": {
                          "type": "integer"
                        },
                        "total_reactions": {
                          "type": "integer"
                        },
                        "total_community_users": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    },
                    "current_status": {
                      "type": "object",
                      "properties": {
                        "migrated_groups": {
                          "type": "object",
                          "properties": {
                            "1": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "last_activity_id": {
                          "type": "integer"
                        },
                        "migrated_posts_count": {
                          "type": "integer"
                        },
                        "last_migrated_user_id": {
                          "type": "integer"
                        },
                        "last_migrated_member_id": {
                          "type": "integer"
                        },
                        "current_stage": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "has_previous": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "groupItems": [
                    {
                      "id": "1",
                      "name": "Product Feedback",
                      "members_count": 42,
                      "is_migrated": true
                    },
                    {
                      "id": "2",
                      "name": "Beta Testers",
                      "members_count": 18,
                      "is_migrated": false
                    }
                  ],
                  "featureConfig": {
                    "has_groups": true
                  },
                  "stats": {
                    "groups": 2,
                    "total_posts": 184,
                    "total_comments": 312,
                    "total_reactions": 0,
                    "total_community_users": 57
                  },
                  "current_status": {
                    "migrated_groups": {
                      "1": 14
                    },
                    "last_activity_id": 0,
                    "migrated_posts_count": 0,
                    "last_migrated_user_id": 0,
                    "last_migrated_member_id": 0,
                    "current_stage": "groups"
                  },
                  "has_previous": true
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

  "paths": {
    "/courses": {
      "get": {
        "operationId": "listCourses",
        "summary": "GET List Courses",
        "description": "Returns the paginated course catalogue visible to the current user, each entry carrying its enrolment state, progress, section and lesson counts.\n\nController: `CourseController@getCourses`\nRoute source: `fluent-community/Modules/Course/Http/course_api.php:10`",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getCourses().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic_slug",
            "in": "query",
            "required": false,
            "description": "Topic Slug read via `$request->getSafe()` in getCourses().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Type read via `$request->getSafe()` in getCourses().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "Sort By read via `$request->getSafe()` in getCourses().",
            "schema": {
              "type": "string",
              "default": "alphabetical"
            }
          },
          {
            "name": "with_categories",
            "in": "query",
            "required": false,
            "description": "With Categories read via `$request->get()` in getCourses().",
            "schema": {
              "type": "string"
            }

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/courses/{course_slug}/lessons/{lesson_slug}/by-slug": {
      "get": {
        "operationId": "getLessonBySlug",
        "summary": "GET Get Lesson By Slug",
        "description": "Returns a single lesson by course and lesson slug, with its access decision resolved and its body parsed only when the caller may read it.\n\nController: `CourseController@getLessonBySlug`\nRoute source: `fluent-community/Modules/Course/Http/course_api.php:13`",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "course_slug",
            "in": "path",
            "required": true,
            "description": "Course Slug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lesson_slug",
            "in": "path",
            "required": true,
            "description": "Lesson Slug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lesson": {
                      "type": "object",
                      "properties": {
                        "can_view": {
                          "type": "boolean"
                        },
                        "comments_count": {
                          "type": "integer"
                        },
                        "content": {
                          "type": "string",
                          "nullable": false
                        },
                        "content_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "course_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "featured_image": {
                          "type": "string",
                          "nullable": true
                        },
                        "id": {
                          "type": "integer"
                        },
                        "inline_css": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_locked": {
                          "type": "boolean"
                        },
                        "lock_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "auto_complete_on_video_end": {
                              "type": "string",
                              "nullable": false
                            },
                            "document_ids": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "document_lists": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "enable_comments": {
                              "type": "string",
                              "nullable": false
                            },
                            "enable_media": {
                              "type": "string",
                              "nullable": false
                            },
                            "enable_passing_score": {
                              "type": "string",
                              "nullable": false
                            },
                            "enforce_passing_score": {
                              "type": "string",
                              "nullable": false
                            },
                            "free_preview_lesson": {
                              "type": "string",
                              "nullable": false
                            },
                            "hide_result": {
                              "type": "string",
                              "nullable": false
                            },
                            "is_video_gated": {
                              "type": "boolean"
                            },
                            "media": {
                              "type": "object",
                              "properties": {
                                "provider": {
                                  "type": "string",
                                  "nullable": false
                                }
                              },
                              "additionalProperties": false
                            },
                            "passing_score": {
                              "type": "integer"
                            },
                            "require_video_completion": {
                              "type": "string",
                              "nullable": false
                            },
                            "video_auto_complete": {
                              "type": "boolean"
                            },
                            "video_completion_threshold": {
                              "type": "integer"
                            },
                            "video_length": {
                              "type": "integer"
                            },
                            "video_watched": {
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "section_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "unlock_date": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "lesson": {
                    "can_view": true,
                    "comments_count": 0,
                    "content": "Great point — I ran into the same thing last week.",
                    "content_type": "text",
                    "course_id": "114",
                    "created_at": "2026-08-17 22:38:06",
                    "featured_image": null,
                    "id": 15054,
                    "inline_css": "",
                    "is_locked": false,
                    "lock_type": "",
                    "meta": {
                      "auto_complete_on_video_end": "no",
                      "document_ids": [],
                      "document_lists": [],
                      "enable_comments": "no",
                      "enable_media": "no",
                      "enable_passing_score": "no",
                      "enforce_passing_score": "no",
                      "free_preview_lesson": "no",
                      "hide_result": "no",
                      "is_video_gated": false,
                      "media": {
                        "provider": ""
                      },
                      "passing_score": 0,
                      "require_video_completion": "no",
                      "video_auto_complete": false,
                      "video_completion_threshold": 80,
                      "video_length": 0,
                      "video_watched": false
                    },
                    "section_id": "15051",
                    "slug": "welcome-to-the-course-1787006286",
                    "title": "Welcome to the course",
                    "unlock_date": ""
                  }
                }
              }
            }
          },
          "422": {
            "description": "You must need to be invited to view this course",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You must need to be invited to view this course"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

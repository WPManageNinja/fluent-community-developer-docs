  "paths": {
    "/admin/courses/{course_id}/lockscreens": {
      "put": {
        "operationId": "updateCourseLockscreenSettings",
        "summary": "PUT Update Course Lockscreen Settings",
        "description": "Stores the lock screen a private course shows to visitors who are not enrolled — its copy, imagery and call to action.\n\nController: `ProAdminController@updateCourseLockscreenSettings`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:63`",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "description": "Course ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lockscreen": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "lockscreen": [
                  {
                    "background_image": "",
                    "button_color": "#2B2E33",
                    "button_link": "",
                    "button_text": "Enrol now",
                    "button_text_color": "#FFFFFF",
                    "description": "This course is available to enrolled students.",
                    "heading": "Enrol to continue",
                    "heading_color": "#FFFFFF",
                    "hidden": false,
                    "label": "Banner",
                    "name": "banner",
                    "new_tab": "no",
                    "overlay_color": "#798398",
                    "text_color": "#FFFFFF",
                    "type": "image"
                  },
                  {
                    "content": "Great point — I ran into the same thing last week.",
                    "hidden": false,
                    "label": "Description",
                    "name": "description",
                    "type": "block"
                  },
                  {
                    "background_image": "",
                    "button_color": "#2B2E33",
                    "button_link": "",
                    "button_text": "Buy Now",
                    "button_text_color": "#FFFFFF",
                    "description": "A place to introduce yourself and meet other members.",
                    "heading": "Feature request round-up",
                    "heading_color": "#FFFFFF",
                    "hidden": false,
                    "label": "Call to action",
                    "name": "action",
                    "new_tab": "no",
                    "overlay_color": "#798398",

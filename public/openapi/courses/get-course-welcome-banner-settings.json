                      "enabled": "no",
                      "mediaType": "image",
                      "title": ""
                    },
                    "not_enrolled": {
                      "allowClose": "no",
                      "bannerImage": "",
                      "bannerVideo": {
                        "author_name": "",
                        "content_type": "",
                        "html": "",
                        "provider": "",
                        "title": "",
                        "type": "oembed",
                        "url": ""
                      },
                      "ctaButtons": [],
                      "description": "",
                      "enabled": "no",
                      "mediaType": "image",
                      "title": ""

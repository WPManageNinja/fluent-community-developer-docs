                            "bannerImage": {
                              "type": "string",
                              "nullable": false
                            },
                            "bannerVideo": {
                              "type": "object",
                              "properties": {
                                "author_name": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "content_type": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "html": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "provider": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "title": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "type": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "url": {
                                  "type": "string",
                                  "nullable": false
                                }

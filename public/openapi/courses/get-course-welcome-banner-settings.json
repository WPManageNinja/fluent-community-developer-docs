                                "provider": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "title": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "type": {
                                  "type": "string",
                                  "nullable": false
                                },
                                "url": {
                                  "type": "string",
                                  "nullable": false
                                }
                              },
                              "additionalProperties": false
                            },
                            "ctaButtons": {

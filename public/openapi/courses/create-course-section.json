          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "section": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "lessons": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "preview_data": {
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "additionalProperties": false
                        },
                        "priority": {
                          "type": "integer"
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "space_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Just tried it and it works exactly as described.",
                  "section": {
                    "created_at": "2026-08-17 22:38:06",
                    "id": 15051,
                    "lessons": [],
                    "meta": {

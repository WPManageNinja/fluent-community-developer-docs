      "get": {
        "operationId": "listCourseStudents",
        "summary": "GET List Course Students",
        "description": "Returns the paginated roster of a course, each student carrying their enrolment pivot and their completion percentage.\n\nController: `CourseAdminController@getCourseStudents`\nRoute source: `fluent-community/Modules/Course/Http/course_api.php:29`",

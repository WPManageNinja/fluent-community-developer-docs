{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/courses/{course_id}/lessons/{lesson_id}": {
      "put": {
        "operationId": "updateCourseLesson",
        "summary": "PUT Update Course Lesson",
        "description": "Saves the full lesson record — title, status, body and metadata — and reconciles the featured image media.\n\nController: `CourseAdminController@updateLesson`\nRoute source: `fluent-community/Modules/Course/Http/course_api.php:57`",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "description": "Course ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "description": "Lesson ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lesson": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "parent_id",
                  "status"
                ]
              },
              "example": {
                "lesson": {
                  "message": "Great point — I ran into the same thing last week.",
                  "parent_id": 15070,
                  "status": "published",
                  "title": "Welcome to the course"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lesson": {
                      "type": "object",
                      "properties": {
                        "comments_count": {
                          "type": "integer"
                        },
                        "content_type": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "expired_at": {
                          "type": "string",
                          "nullable": true
                        },
                        "featured_image": {
                          "type": "string",
                          "nullable": true
                        },
                        "id": {
                          "type": "integer"
                        },
                        "is_sticky": {
                          "type": "string",
                          "nullable": false
                        },
                        "message": {
                          "type": "string",
                          "nullable": false
                        },
                        "message_rendered": {
                          "type": "string",
                          "nullable": true
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "auto_complete_on_video_end": {
                              "type": "string",
                              "nullable": false
                            },
                            "document_ids": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "document_lists": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "enable_comments": {
                              "type": "string",
                              "nullable": false
                            },
                            "enable_media": {
                              "type": "string",
                              "nullable": false
                            },
                            "enable_passing_score": {
                              "type": "string",
                              "nullable": false
                            },
                            "enforce_passing_score": {
                              "type": "string",
                              "nullable": false
                            },
                            "free_preview_lesson": {
                              "type": "string",
                              "nullable": false
                            },
                            "hide_result": {
                              "type": "string",
                              "nullable": false
                            },
                            "media": {
                              "type": "object",
                              "properties": {
                                "provider": {
                                  "type": "string",
                                  "nullable": false
                                }
                              },
                              "additionalProperties": false
                            },
                            "passing_score": {
                              "type": "integer"
                            },
                            "require_video_completion": {
                              "type": "string",
                              "nullable": false
                            },
                            "video_completion_threshold": {
                              "type": "integer"
                            },
                            "video_length": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": false
                        },
                        "parent_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "priority": {
                          "type": "string",
                          "nullable": false
                        },
                        "privacy": {
                          "type": "string",
                          "nullable": false
                        },
                        "reactions_count": {
                          "type": "integer"
                        },
                        "scheduled_at": {
                          "type": "string",
                          "nullable": true
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "space_id": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "lesson": {
                    "comments_count": 0,
                    "content_type": "text",
                    "created_at": "2026-08-17 22:39:56",
                    "expired_at": null,
                    "featured_image": null,
                    "id": 15073,
                    "is_sticky": "0",
                    "message": "Great point — I ran into the same thing last week.",
                    "message_rendered": null,
                    "meta": {
                      "auto_complete_on_video_end": "no",
                      "document_ids": [],
                      "document_lists": [],
                      "enable_comments": "no",
                      "enable_media": "no",
                      "enable_passing_score": "no",
                      "enforce_passing_score": "no",
                      "free_preview_lesson": "no",
                      "hide_result": "no",
                      "media": {
                        "provider": ""
                      },
                      "passing_score": 0,
                      "require_video_completion": "no",
                      "video_completion_threshold": 0,
                      "video_length": 0
                    },
                    "parent_id": "15070",
                    "priority": "1",
                    "privacy": "public",
                    "reactions_count": 0,
                    "scheduled_at": null,
                    "slug": "welcome-to-the-course-1787006396",
                    "space_id": "123",
                    "status": "published",
                    "title": "Welcome to the course",
                    "type": "course_lesson",
                    "updated_at": "2026-08-17 22:39:56",
                    "user_id": "1"
                  },
                  "message": "Great point — I ran into the same thing last week."
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/admin/courses": {
      "post": {
        "operationId": "createCourse",
        "summary": "POST Create Course",
        "description": "Creates a course in draft state, with its type, privacy, layout and lock screen behaviour set from the submitted settings.\n\nController: `CourseAdminController@createCourse`\nRoute source: `fluent-community/Modules/Course/Http/course_api.php:23`",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "parent_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "privacy": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "course_type": {
                    "type": "string"
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "emoji": {
                        "type": "string"
                      },
                      "shape_svg": {
                        "type": "string"
                      },
                      "disable_comments": {
                        "type": "string"
                      },
                      "hide_members_count": {
                        "type": "string"
                      },
                      "course_layout": {
                        "type": "string"
                      },
                      "course_details": {
                        "type": "string"
                      },
                      "hide_instructor_view": {
                        "type": "string"
                      },
                      "show_instructor_students_count": {
                        "type": "string"
                      },
                      "sequential_lesson_order": {
                        "type": "string"
                      },
                      "custom_lock_screen": {
                        "type": "string"
                      },
                      "onboard_redirect_url": {
                        "type": "string"
                      },
                      "public_lesson_view": {
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "slug": {
                    "type": "string"
                  },
                  "category_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "title",
                  "privacy",
                  "description",
                  "course_type"
                ]
              },
              "example": {
                "course_type": "self_paced",
                "description": "Everything you need to get productive in your first week.",
                "privacy": "public",
                "settings": {
                  "course_details": "",
                  "course_layout": "classic",
                  "emoji": "",
                  "shape_svg": ""
                },
                "slug": "getting-started-with-the-platform",
                "status": "published",
                "title": "Getting Started with the Platform"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "course": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_by": {
                          "type": "integer"
                        },
                        "description": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "integer"
                        },
                        "parent_id": {
                          "type": "string",
                          "nullable": true
                        },
                        "privacy": {
                          "type": "string",
                          "nullable": false
                        },
                        "serial": {
                          "type": "integer"
                        },
                        "settings": {
                          "type": "object",
                          "properties": {
                            "can_request_join": {
                              "type": "string",
                              "nullable": false
                            },
                            "course_details": {
                              "type": "string",
                              "nullable": false
                            },
                            "course_layout": {
                              "type": "string",
                              "nullable": false
                            },
                            "course_type": {
                              "type": "string",
                              "nullable": false
                            },
                            "custom_lock_screen": {
                              "type": "string",
                              "nullable": false
                            },
                            "disable_comments": {
                              "type": "string",
                              "nullable": false
                            },
                            "emoji": {
                              "type": "string",
                              "nullable": false
                            },
                            "hide_instructor_view": {
                              "type": "string",
                              "nullable": false
                            },
                            "hide_members_count": {
                              "type": "string",
                              "nullable": false
                            },
                            "layout_style": {
                              "type": "string",
                              "nullable": false
                            },
                            "links": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "members_page_status": {
                              "type": "string",
                              "nullable": false
                            },
                            "og_image": {
                              "type": "string",
                              "nullable": false
                            },
                            "public_lesson_view": {
                              "type": "string",
                              "nullable": false
                            },
                            "restricted_post_only": {
                              "type": "string",
                              "nullable": false
                            },
                            "sequential_lesson_order": {
                              "type": "string",
                              "nullable": false
                            },
                            "shape_svg": {
                              "type": "string",
                              "nullable": false
                            },
                            "show_instructor_students_count": {
                              "type": "string",
                              "nullable": false
                            },
                            "show_sidebar": {
                              "type": "string",
                              "nullable": false
                            },
                            "topic_required": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "slug": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "title": {
                          "type": "string",
                          "nullable": false
                        },
                        "type": {
                          "type": "string",
                          "nullable": false
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "course": {
                    "created_at": "2026-08-17 22:39:56",
                    "created_by": 1,
                    "description": "Everything you need to get productive in your first week.",
                    "id": 123,
                    "parent_id": null,
                    "privacy": "public",
                    "serial": 21,
                    "settings": {
                      "can_request_join": "no",
                      "course_details": "",
                      "course_layout": "classic",
                      "course_type": "self_paced",
                      "custom_lock_screen": "no",
                      "disable_comments": "no",
                      "emoji": "",
                      "hide_instructor_view": "no",
                      "hide_members_count": "no",
                      "layout_style": "timeline",
                      "links": [],
                      "members_page_status": "members_only",
                      "og_image": "",
                      "public_lesson_view": "no",
                      "restricted_post_only": "no",
                      "sequential_lesson_order": "no",
                      "shape_svg": "",
                      "show_instructor_students_count": "no",
                      "show_sidebar": "yes",
                      "topic_required": "no"
                    },
                    "slug": "getting-started-with-the-platform",
                    "status": "published",
                    "title": "Getting Started with the Platform",
                    "type": "course",
                    "updated_at": "2026-08-17 22:39:56"
                  },
                  "message": "Just tried it and it works exactly as described."
                }
              }
            }
          },
          "422": {
            "description": "Course Redirect URL is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Course Redirect URL is not valid"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

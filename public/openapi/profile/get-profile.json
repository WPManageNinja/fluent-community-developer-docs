{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/profile/{username}": {
      "get": {
        "operationId": "getProfile",
        "summary": "GET Get Profile",
        "description": "Returns one member public profile by username, with the navigation tabs the portal should render for that member.\n\nController: `ProfileController@getProfile`\nRoute source: `fluent-community/app/Http/Routes/api.php:86`",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "object",
                      "properties": {
                        "avatar": {
                          "type": "string",
                          "nullable": false
                        },
                        "badge_slugs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "nullable": false
                          }
                        },
                        "canViewUserSpaces": {
                          "type": "boolean"
                        },
                        "can_change_email": {
                          "type": "boolean"
                        },
                        "can_change_password": {
                          "type": "boolean"
                        },
                        "can_change_username": {
                          "type": "boolean"
                        },
                        "compilation_score": {
                          "type": "integer"
                        },
                        "cover_photo": {
                          "type": "string",
                          "nullable": false
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "display_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "email": {
                          "type": "string",
                          "nullable": false
                        },
                        "first_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "followers_count": {
                          "type": "integer"
                        },
                        "followings_count": {
                          "type": "integer"
                        },
                        "has_custom_avatar": {
                          "type": "boolean"
                        },
                        "headline": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_moderator": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_restricted": {
                          "type": "boolean"
                        },
                        "is_verified": {
                          "type": "integer"
                        },
                        "last_activity": {
                          "type": "string",
                          "nullable": false
                        },
                        "last_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "profile_nav_actions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "profile_navs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "route": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "nullable": false
                                  }
                                },
                                "additionalProperties": false
                              },
                              "slug": {
                                "type": "string",
                                "nullable": false
                              },
                              "title": {
                                "type": "string",
                                "nullable": false
                              },
                              "url": {
                                "type": "string",
                                "nullable": false
                              },
                              "wrapper_class": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "scheduled_posts_count": {
                          "type": "integer"
                        },
                        "short_description": {
                          "type": "string",
                          "nullable": false
                        },
                        "short_description_rendered": {
                          "type": "string",
                          "nullable": false
                        },
                        "social_links": {
                          "type": "object",
                          "properties": {
                            "fb": {
                              "type": "string",
                              "nullable": false
                            },
                            "instagram": {
                              "type": "string",
                              "nullable": false
                            },
                            "linkedin": {
                              "type": "string",
                              "nullable": false
                            },
                            "twitter": {
                              "type": "string",
                              "nullable": false
                            },
                            "youtube": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "total_points": {
                          "type": "integer"
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "username": {
                          "type": "string",
                          "nullable": false
                        },
                        "website": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "profile": {
                    "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/alex_rivera.png",
                    "badge_slugs": [
                      "admin"
                    ],
                    "canViewUserSpaces": true,
                    "can_change_email": true,
                    "can_change_password": true,
                    "can_change_username": true,
                    "compilation_score": 100,
                    "cover_photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/covers/cover.jpg",
                    "created_at": "2024-03-05 16:37:02",
                    "display_name": "Alex Rivera",
                    "email": "alex.rivera@example.com",
                    "first_name": "Mei",
                    "followers_count": 173,
                    "followings_count": 66,
                    "has_custom_avatar": true,
                    "headline": "",
                    "is_moderator": "yes",
                    "is_restricted": false,
                    "is_verified": 1,
                    "last_activity": "2026-08-17 22:35:43",
                    "last_name": "alex_rivera",
                    "profile_nav_actions": [],
                    "profile_navs": [
                      {
                        "route": {
                          "name": "Alex Rivera"
                        },
                        "slug": "user_profile",
                        "title": "Share your workflow setup",
                        "url": "https://yourwebsite.com/portal/u/alex_rivera/",
                        "wrapper_class": "fcom_profile_about"
                      },
                      {
                        "route": {
                          "name": "Alex Rivera"
                        },
                        "slug": "user_profile_feeds",
                        "title": "How we plan our release cycle",
                        "url": "https://yourwebsite.com/portal/u/alex_rivera/posts",
                        "wrapper_class": "fcom_profile_posts"
                      },
                      {
                        "route": {
                          "name": "Alex Rivera"
                        },
                        "slug": "user_spaces",
                        "title": "How we plan our release cycle",
                        "url": "https://yourwebsite.com/portal/u/alex_rivera/spaces",
                        "wrapper_class": "fcom_profile_spaces"
                      }
                    ],
                    "scheduled_posts_count": 1,
                    "short_description": "Community builder. Helping members get the most out of the platform.",
                    "short_description_rendered": "<p>Community builder. Helping members get the most out of the platform.</p>",
                    "social_links": {
                      "fb": "alexrivera",
                      "instagram": "alexrivera",
                      "linkedin": "alexrivera",
                      "twitter": "alexrivera",
                      "youtube": "alexrivera"
                    },
                    "status": "active",
                    "total_points": 20385,
                    "user_id": 1,
                    "username": "alex_rivera",
                    "website": "https://example.com"
                  }
                }
              }
            }
          },
          "403": {
            "description": "This profile is not active",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "This profile is not active"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

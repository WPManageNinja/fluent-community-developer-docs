{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/profile/{username}": {
      "post": {
        "operationId": "updateProfile",
        "summary": "POST Update Profile",
        "description": "Saves the editable profile fields — names, bio, headline, website and social links — and mirrors the display name onto the WordPress user record.\n\nController: `ProfileController@updateProfile`\nRoute source: `fluent-community/app/Http/Routes/api.php:87`",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "is_verified": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "username": {
                        "type": "string"
                      },
                      "badge_slugs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "first_name": {
                        "type": "string"
                      },
                      "last_name": {
                        "type": "string"
                      },
                      "short_description": {
                        "type": "string"
                      },
                      "website": {
                        "type": "string"
                      },
                      "headline": {
                        "type": "string"
                      },
                      "social_links": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "email": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "first_name"
                    ]
                  }
                }
              },
              "example": {
                "data": {
                  "first_name": "Mei",
                  "headline": "Product Designer",
                  "last_name": "Mei",
                  "short_description": "Designer and illustrator. I post work-in-progress shots.",
                  "social_links": [],
                  "username": "mei_tanaka_3",
                  "website": "https://example.com"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "avatar": {
                          "type": "string",
                          "nullable": false
                        },
                        "badge": {
                          "type": "string",
                          "nullable": true
                        },
                        "compilation_score": {
                          "type": "integer"
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "display_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_verified": {
                          "type": "integer"
                        },
                        "last_activity": {
                          "type": "string",
                          "nullable": true
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "badge_slug": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            },
                            "cover_photo": {
                              "type": "string",
                              "nullable": false
                            },
                            "headline": {
                              "type": "string",
                              "nullable": false
                            },
                            "short_description_rendered": {
                              "type": "string",
                              "nullable": false
                            },
                            "website": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "permalink": {
                          "type": "string",
                          "nullable": false
                        },
                        "short_description": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "total_points": {
                          "type": "integer"
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user": {
                          "type": "object",
                          "properties": {
                            "ID": {
                              "type": "integer"
                            },
                            "display_name": {
                              "type": "string",
                              "nullable": false
                            },
                            "photo": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_email": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_login": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_nicename": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_registered": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_status": {
                              "type": "string",
                              "nullable": false
                            },
                            "user_url": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "username": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "message": "Just tried it and it works exactly as described.",
                  "profile": {
                    "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka_3.png",
                    "badge": null,
                    "compilation_score": 100,
                    "created_at": "2026-08-17 21:31:52",
                    "display_name": "Mei Tanaka",
                    "id": "12393",
                    "is_verified": 0,
                    "last_activity": null,
                    "meta": {
                      "badge_slug": [],
                      "cover_photo": "",
                      "headline": "Product Designer",
                      "short_description_rendered": "<p>Designer and illustrator. I post work-in-progress shots.</p>",
                      "website": "https://example.com"
                    },
                    "permalink": "https://yourwebsite.com/portal/u/mei_tanaka_3",
                    "short_description": "Designer and illustrator. I post work-in-progress shots.",
                    "status": "active",
                    "total_points": 0,
                    "updated_at": "2026-08-17 21:56:17",
                    "user": {
                      "ID": 13096,
                      "display_name": "Mei Tanaka",
                      "photo": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka_3.png",
                      "user_email": "mei.tanaka.3@example.com",
                      "user_login": "mei_tanaka_3",
                      "user_nicename": "mei_tanaka_3",
                      "user_registered": "2026-08-17 21:31:52",
                      "user_status": "0",
                      "user_url": "https://example.com"
                    },
                    "user_id": 13096,
                    "username": "mei_tanaka_3"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Email address already taken by someone else. Please use a different email address.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Email address already taken by someone else. Please use a different email address."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

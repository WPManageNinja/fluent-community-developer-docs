{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/profile/{username}/follow": {
      "post": {
        "operationId": "followProfileUser",
        "summary": "POST Follow Profile User",
        "description": "Creates a follow relationship from the current user to the named member.\n\nController: `FollowController@follow`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:131`",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follow": {
                      "type": "object",
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "followed_id": {
                          "type": "integer"
                        },
                        "follower_id": {
                          "type": "integer"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "level": {
                          "type": "integer"
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": false
                    },
                    "xprofile": {
                      "type": "object",
                      "properties": {
                        "avatar": {
                          "type": "string",
                          "nullable": false
                        },
                        "badge": {
                          "type": "string",
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "display_name": {
                          "type": "string",
                          "nullable": false
                        },
                        "id": {
                          "type": "string",
                          "nullable": false
                        },
                        "is_verified": {
                          "type": "integer"
                        },
                        "last_activity": {
                          "type": "string",
                          "nullable": true
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "cover_photo": {
                              "type": "string",
                              "nullable": false
                            },
                            "short_description_rendered": {
                              "type": "string",
                              "nullable": false
                            },
                            "website": {
                              "type": "string",
                              "nullable": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "permalink": {
                          "type": "string",
                          "nullable": false
                        },
                        "short_description": {
                          "type": "string",
                          "nullable": false
                        },
                        "status": {
                          "type": "string",
                          "nullable": false
                        },
                        "total_points": {
                          "type": "integer"
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": false
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "username": {
                          "type": "string",
                          "nullable": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "follow": {
                    "created_at": "2026-08-17 22:39:20",
                    "followed_id": 13097,
                    "follower_id": 13096,
                    "id": 1732,
                    "level": 1,
                    "updated_at": "2026-08-17 22:39:20"
                  },
                  "message": "Great point — I ran into the same thing last week.",
                  "xprofile": {
                    "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka.png",
                    "badge": null,
                    "created_at": "2026-08-17 21:31:53",
                    "display_name": "Mei Tanaka",
                    "id": "12394",
                    "is_verified": 0,
                    "last_activity": null,
                    "meta": {
                      "cover_photo": "",
                      "short_description_rendered": "<p>Designer and illustrator. I post work-in-progress shots.</p>",
                      "website": ""
                    },
                    "permalink": "https://yourwebsite.com/portal/u/mei_tanaka",
                    "short_description": "Designer and illustrator. I post work-in-progress shots.",
                    "status": "active",
                    "total_points": 0,
                    "updated_at": "2026-08-17 21:37:21",
                    "user_id": 13097,
                    "username": "mei_tanaka"
                  }
                }
              }
            }
          },
          "422": {
            "description": "You are already following or blocked this user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You are already following or blocked this user."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

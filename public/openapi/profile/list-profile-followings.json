  "paths": {
    "/profile/{username}/followings": {
      "get": {
        "operationId": "listProfileFollowings",
        "summary": "GET List Profile Followings",
        "description": "Returns the paginated list of members this profile follows, each annotated with whether the current user follows them too.\n\nController: `FollowController@getFollowings`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:129`",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search read via `$request->getSafe()` in getFollowings().",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "Sort By read via `$request->getSafe()` in getFollowings().",
            "schema": {
              "type": "string",
              "default": "id"
            }
          }
        ],

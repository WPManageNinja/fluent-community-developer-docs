{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/profile/{username}/blocked-users": {
      "get": {
        "operationId": "listProfileBlockedUsers",
        "summary": "GET List Profile Blocked Users",
        "description": "Returns the paginated list of members this profile has blocked.\n\nController: `FollowController@getBlockedUsers`\nRoute source: `fluent-community-pro/app/Http/Routes/api.php:133`",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blockedUsers": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "first_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "from": {
                          "type": "string",
                          "nullable": true
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string",
                          "nullable": false
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "active": {
                                "type": "boolean"
                              },
                              "label": {
                                "type": "string",
                                "nullable": false
                              },
                              "url": {
                                "type": "string",
                                "nullable": true
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "path": {
                          "type": "string",
                          "nullable": false
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "string",
                          "nullable": true
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "blockedUsers": {
                    "current_page": 1,
                    "data": [],
                    "first_page_url": "https://yourwebsite.com/?page=1",
                    "from": null,
                    "last_page": 1,
                    "last_page_url": "https://yourwebsite.com/?page=1",
                    "links": [
                      {
                        "active": false,
                        "label": "pagination.previous",
                        "url": null
                      },
                      {
                        "active": true,
                        "label": "1",
                        "url": "https://yourwebsite.com/?page=1"
                      },
                      {
                        "active": false,
                        "label": "pagination.next",
                        "url": null
                      }
                    ],
                    "next_page_url": null,
                    "path": "https://yourwebsite.com",
                    "per_page": 15,
                    "prev_page_url": null,
                    "to": null,
                    "total": 0
                  }
                }
              }
            }
          },
          "403": {
            "description": "You do not have permission to view this list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You do not have permission to view this list."
                }
              }
            }
          },
          "422": {
            "description": "This profile is not active",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "This profile is not active"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}

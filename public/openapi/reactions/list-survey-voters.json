{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCommunity API",
    "description": "Complete REST API documentation for FluentCommunity — a WordPress community and forum plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-community/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/feeds/{feed_id}/apps/survey-voters/{option_slug}": {
      "get": {
        "operationId": "listSurveyVoters",
        "summary": "GET List Survey Voters",
        "description": "Returns the members who voted for one survey option, with their public profiles.\n\nController: `ReactionController@getSurveyVoters`\nRoute source: `fluent-community/app/Http/Routes/api.php:80`",
        "tags": [
          "Reactions"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "feed_id",
            "in": "path",
            "required": true,
            "description": "Feed ID extracted from the URL path.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "option_slug",
            "in": "path",
            "required": true,
            "description": "Option Slug extracted from the URL path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voters": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "created_at": {
                            "type": "string",
                            "nullable": false
                          },
                          "id": {
                            "type": "integer"
                          },
                          "object_id": {
                            "type": "string",
                            "nullable": false
                          },
                          "object_type": {
                            "type": "string",
                            "nullable": false
                          },
                          "parent_id": {
                            "type": "string",
                            "nullable": true
                          },
                          "type": {
                            "type": "string",
                            "nullable": false
                          },
                          "updated_at": {
                            "type": "string",
                            "nullable": false
                          },
                          "user_id": {
                            "type": "string",
                            "nullable": false
                          },
                          "xprofile": {
                            "type": "object",
                            "properties": {
                              "avatar": {
                                "type": "string",
                                "nullable": false
                              },
                              "badge": {
                                "type": "string",
                                "nullable": true
                              },
                              "created_at": {
                                "type": "string",
                                "nullable": false
                              },
                              "display_name": {
                                "type": "string",
                                "nullable": false
                              },
                              "is_verified": {
                                "type": "integer"
                              },
                              "last_activity": {
                                "type": "string",
                                "nullable": true
                              },
                              "meta": {
                                "type": "object",
                                "properties": {
                                  "badge_slug": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": true
                                    }
                                  },
                                  "cover_photo": {
                                    "type": "string",
                                    "nullable": false
                                  },
                                  "headline": {
                                    "type": "string",
                                    "nullable": false
                                  },
                                  "short_description_rendered": {
                                    "type": "string",
                                    "nullable": false
                                  },
                                  "website": {
                                    "type": "string",
                                    "nullable": false
                                  }
                                },
                                "additionalProperties": false
                              },
                              "permalink": {
                                "type": "string",
                                "nullable": false
                              },
                              "short_description": {
                                "type": "string",
                                "nullable": false
                              },
                              "status": {
                                "type": "string",
                                "nullable": false
                              },
                              "total_points": {
                                "type": "integer"
                              },
                              "user_id": {
                                "type": "integer"
                              },
                              "username": {
                                "type": "string",
                                "nullable": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "voters": [
                    {
                      "created_at": "2026-08-17 22:39:19",
                      "id": 102070,
                      "object_id": "15049",
                      "object_type": "better-search",
                      "parent_id": null,
                      "type": "survey_vote",
                      "updated_at": "2026-08-17 22:39:19",
                      "user_id": "13096",
                      "xprofile": {
                        "avatar": "https://yourwebsite.com/wp-content/uploads/fluent-community/avatars/mei_tanaka_3.png",
                        "badge": null,
                        "created_at": "2026-08-17 21:31:52",
                        "display_name": "Mei Tanaka",
                        "is_verified": 0,
                        "last_activity": null,
                        "meta": {
                          "badge_slug": [],
                          "cover_photo": "",
                          "headline": "Product Designer",
                          "short_description_rendered": "<p>Designer and illustrator. I post work-in-progress shots.</p>",
                          "website": "https://example.com"
                        },
                        "permalink": "https://yourwebsite.com/portal/u/mei_tanaka_3",
                        "short_description": "Designer and illustrator. I post work-in-progress shots.",
                        "status": "active",
                        "total_points": 0,
                        "user_id": 13096,
                        "username": "mei_tanaka_3"
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Request validation or permission error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request validation or permission error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}
